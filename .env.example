# ── CrowdGuard Environment Variables ─────────────────────────

# Backend API
API_HOST=0.0.0.0
API_PORT=8000

# Accounts and login
# Password for the 'admin' account created on the very first start.
# Leave empty to have one generated and printed in the server log.
CROWDGUARD_ADMIN_PASSWORD=
# Key that signs login tokens (default: generated into data/secret.key)
# CROWDGUARD_SECRET=
# How long a login lasts, in hours
CROWDGUARD_TOKEN_HOURS=12

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# YOLO model path (relative to project root)
YOLO_MODEL_PATH=yolov8n.pt

# Detection settings
DETECTION_CONFIDENCE=0.15
MAX_DETECTIONS=100

# Alert thresholds
RISK_THRESHOLD=0.7
ANOMALY_THRESHOLD=0.6
CAPACITY_LIMIT=30

# Privacy
PRIVACY_ENABLED=true
BLUR_STRENGTH=51
